# ---------------------------------------------------------------------------
# Configuración de Docker Compose
# Copia este archivo como `.env` (cp .env.example .env) y ajusta los valores.
# Todos los valores tienen un respaldo en compose.yaml, por lo que la
# aplicación también puede arrancar sin este archivo.
# ---------------------------------------------------------------------------

# Puerto público de la aplicación (http://localhost:8090)
APP_PORT=8090
APP_NAME=Aspirantes CIMAT
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8090

# Si se deja vacío, el contenedor genera una clave efímera al arrancar.
# Para producción, genera una con: docker compose exec app php artisan key:generate --show
APP_KEY=

LOG_LEVEL=warning

# Base de datos (MariaDB). Cambia las contraseñas antes de desplegar.
DB_DATABASE=aspirantes
DB_USERNAME=aspirantes
DB_PASSWORD=aspirantes_secret
DB_ROOT_PASSWORD=aspirantes_root_secret

# Carga los datos de demostración en cada arranque (el seeder es idempotente).
SEED_DB=true

# Puerto de Adminer (perfil "tools"): docker compose --profile tools up -d
ADMINER_PORT=8091
